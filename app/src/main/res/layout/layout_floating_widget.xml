<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start">

    <!-- Draggable Neon-Cyan Circular Floating Bubble -->
    <ImageButton
        android:id="@+id/btn_bubble_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_neon_bubble"
        android:src="@drawable/ic_bubble_crosshair"
        android:contentDescription="Gemini AI Floating Bubble"
        android:elevation="16dp"
        android:padding="10dp" />

    <!-- Glassmorphic Quick-Settings Popup Menu (Expanded on Touch/Double-Tap) -->
    <LinearLayout
        android:id="@+id/panel_expanded_menu"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glassmorphic_popup"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Title & Status Header -->
        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ RAKIB AI AIM ENGINE PRO"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tv_widget_ai_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Physics: Zero-Miss Ray Engine Active"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3300E5FF"
            android:layout_marginBottom="6dp" />

        <!-- 0. MULTI-GAME MODE SWITCHER (Disc Pool / Classic Carrom / Freestyle) -->
        <Button
            android:id="@+id/btn_cycle_game_mode"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🎮 Mode: ⚪ DISC POOL 🔄"
            android:textColor="#060B13"
            android:backgroundTint="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 0.5. STRIKER BASELINE POSITION GUIDE TOGGLE -->
        <Button
            android:id="@+id/btn_toggle_baseline_guide"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="📏 Striker Baseline Guide: ON 🟢"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B5E20"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 1. AUTO-PLAY / AUTO-SHOT ON/OFF TOGGLE -->
        <Button
            android:id="@+id/btn_toggle_autoplay"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🤖 Auto-Play Shot: OFF ⚪"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 2. QUEEN + COVER AUTO-PRIORITY AI -->
        <Button
            android:id="@+id/btn_toggle_queen"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="👑 Queen+Cover Priority: ON 🟢"
            android:textColor="#000000"
            android:backgroundTint="#FFD700"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 2.5. MULTI-TARGET CYCLE TOGGLE (Easiest / Queen / Combo / Bank) -->
        <Button
            android:id="@+id/btn_cycle_target_focus"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="🎯 Target Focus: [Easiest Puck] 🔄"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00838F"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 3. LINE MODE SWITCHER (Direct / 3-Cushion Bank / Laser Pro) -->
        <Button
            android:id="@+id/btn_toggle_line_mode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Mode: 🌟 LASER PRO"
            android:textColor="#000000"
            android:backgroundTint="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 4. OPPONENT TURN STANDBY / BATTERY SAVER -->
        <Button
            android:id="@+id/btn_toggle_opponent_turn"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="⏸️ Opponent Turn (Pause 0% CPU)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#455A64"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 5. LAUNCH CARROM POOL DIRECT INTENT -->
        <Button
            android:id="@+id/btn_launch_carrom"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="🎮 Launch Carrom Disc Pool"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E91E63"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 6. Execute Instant Auto Shot -->
        <Button
            android:id="@+id/btn_trigger_auto_shot"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="⚡ Auto Strike Now (Dynamic Power)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B1FA2"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 7. Line Thickness Adjuster Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_thickness_decrease"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:text="➖"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F"
                android:textSize="11sp"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tv_line_thickness"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Thickness: 5.5dp"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_thickness_increase"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:text="➕"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F"
                android:textSize="11sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- 8. Stealth Mode & Overlay Toggles Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_toggle_stealth"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:text="🛡️ Stealth: ON"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1B5E20"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_toggle_lines"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:text="Overlay: ON"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00838F"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF"
            android:layout_marginBottom="6dp" />

        <!-- Quick In-Game HUD Line Style Selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 IN-GAME HUD QUICK LINE STYLE"
            android:textColor="#B0BEC5"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Top Style Row: RGB Chroma vs Solid Classic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_style_rgb_chroma"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="30dp"
                android:text="🌈 RGB Chroma"
                android:textColor="#FFFFFF"
                android:backgroundTint="#AA00FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_style_solid_classic"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="30dp"
                android:text="⚪ Solid Classic"
                android:textColor="#060B13"
                android:backgroundTint="#ECEFF1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_style_laser_glow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="28dp"
                android:text="Laser"
                android:textColor="#000000"
                android:backgroundTint="#00E5FF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_style_solid_neon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="28dp"
                android:text="Neon"
                android:textColor="#000000"
                android:backgroundTint="#00B0FF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_style_dual_cyber"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="28dp"
                android:text="Cyber"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D500F9"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_style_cyber_green"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="28dp"
                android:text="Green"
                android:textColor="#000000"
                android:backgroundTint="#00E676"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_style_gold_royal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="28dp"
                android:text="Gold"
                android:textColor="#000000"
                android:backgroundTint="#FFD700"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Stop Engine Button -->
        <Button
            android:id="@+id/btn_close_floating"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="🛑 Stop Floating Engine"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Drag bubble to move • Single/Double-Tap to toggle HUD"
            android:textColor="#78909C"
            android:textSize="8.5sp"
            android:gravity="center"
            android:paddingTop="3dp" />
    </LinearLayout>

</LinearLayout>
